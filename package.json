{
  "name": "greed-machine",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "near-sandbox": {
      "tar": "7.5.22"
    }
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3014",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3014",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/database.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "check:ui": "node scripts/check-ui.mjs",
    "contract:build": "node scripts/build-contract.mjs",
    "contract:check": "tsx scripts/check-near-contract.ts",
    "near:plan": "tsx scripts/near-proof.ts",
    "near:deploy": "tsx scripts/near-proof.ts --deploy",
    "near:verify": "tsx scripts/near-proof.ts --verify",
    "verify": "npm run typecheck && npm test && npm run build",
    "token:build": "node scripts/build-contract.mjs --token",
    "token:check": "tsx scripts/check-governance-contract.ts",
    "check:wallet": "tsx scripts/check-wallet-ui.ts",
    "governance:plan": "tsx scripts/governance-proof.ts",
    "governance:deploy": "tsx scripts/governance-proof.ts --deploy",
    "governance:verify": "tsx scripts/governance-proof.ts --verify",
    "foundation:seed": "tsx scripts/foundation-worker.ts --seed",
    "foundation:worker": "tsx scripts/foundation-worker.ts",
    "foundation:tick": "tsx scripts/foundation-worker.ts --once",
    "check:foundation": "node scripts/check-foundation-ui.mjs",
    "business:build": "node scripts/build-contract.mjs --contract business && node scripts/build-contract.mjs --contract demo-vault && node scripts/build-contract.mjs --contract test-dollar",
    "business:check": "tsx scripts/check-business-contract.ts",
    "business:plan": "tsx scripts/business-proof.ts",
    "business:deploy": "tsx scripts/business-proof.ts --deploy",
    "business:verify": "tsx scripts/business-proof.ts --verify",
    "business:ui": "node scripts/check-business-ui.mjs"
  },
  "dependencies": {
    "@hot-labs/near-connect": "^0.11.4",
    "@radix-ui/react-dialog": "^1.3.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "near-api-js": "^7.4.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "near-sandbox": "^0.3.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
