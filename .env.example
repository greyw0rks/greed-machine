# Requires a long random value if the app is exposed outside localhost.
SESSION_SECRET=
GREED_DB_PATH=./data/greed.sqlite
# Required for foundation operator actions outside localhost and for paid model mode.
FOUNDATION_OPERATOR_TOKEN=
# Demo sessions represent only synthetic snapshots, never wallet ownership.
DEMO_SESSIONS_ENABLED=true
# Optional: enable provider-backed analysis in the foundation Operator page.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Explicit prices per million tokens; update for the selected provider/model.
OPENAI_INPUT_USD_PER_MILLION=0.40
OPENAI_OUTPUT_USD_PER_MILLION=1.60
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_POLICY_ACCOUNT=
NEAR_POLICY_CODE_HASH=
NEAR_PROOF_RECORD_ID=
# Both fields are required for wallet sign-in. Only NEAR testnet is supported.
NEAR_GREED_TOKEN_ACCOUNT=
NEAR_GREED_TOKEN_CODE_HASH=
# This wallet may pause/resume only the synthetic treasury.
NEAR_GUARDIAN_ACCOUNT=
# Set true behind HTTPS; keep false for local HTTP development.
COOKIE_SECURE=false
DISCORD_DISCUSSION_URL=
